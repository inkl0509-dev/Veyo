{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)\\.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/platform",
      "destination": "/platform.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/tech",
      "destination": "/tech.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/customer",
      "destination": "/index.html"
    },
    {
      "source": "/:co/manifest-:p.webmanifest",
      "destination": "/manifest-:p.webmanifest"
    },
    {
      "source": "/:co/tech",
      "destination": "/tech.html"
    },
    {
      "source": "/:co/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/:co/customer",
      "destination": "/index.html"
    },
    {
      "source": "/:co/",
      "destination": "/index.html"
    },
    {
      "source": "/:co",
      "destination": "/index.html"
    }
  ]
}
